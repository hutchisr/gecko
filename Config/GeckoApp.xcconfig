#include "GeckoCommon.xcconfig"

PRODUCT_NAME = Gecko
PRODUCT_BUNDLE_IDENTIFIER = me.anemoneya.gecko
INFOPLIST_FILE = App/Info.plist
INFOPLIST_FILE[sdk=macosx*] = App/Info-Catalyst.plist
CODE_SIGN_ENTITLEMENTS = App/Gecko.entitlements
CODE_SIGN_ENTITLEMENTS[sdk=macosx*] = App/GeckoCatalyst.entitlements
CODE_SIGN_ENTITLEMENTS[config=Debug][sdk=macosx*] = App/GeckoCatalystDebug.entitlements
CODE_SIGN_STYLE[sdk=macosx*] = Manual
CODE_SIGN_IDENTITY[sdk=macosx*] = -
DEVELOPMENT_TEAM[sdk=macosx*] =
PROVISIONING_PROFILE_SPECIFIER[sdk=macosx*] =
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
INFOPLIST_KEY_LSMinimumSystemVersion[sdk=macosx*] = 26.0
INFOPLIST_KEY_NSHighResolutionCapable[sdk=macosx*] = YES

// WebRTC is a prebuilt dynamic framework staged by `scripts/build-deps.sh <target>
// webrtc`. App only: the notification service extension includes
// GeckoCommon.xcconfig and must neither link nor embed it. The "Embed WebRTC"
// script phase copies and signs it, which the script sandbox would block.
FRAMEWORK_SEARCH_PATHS = $(inherited) $(GECKO_CORE_PREFIX)/Frameworks
OTHER_LDFLAGS = $(inherited) -framework WebRTC
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks @executable_path/../Frameworks
ENABLE_USER_SCRIPT_SANDBOXING = NO
